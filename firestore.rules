rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // giftStatus/{catalogId}: reserved=true, createdAt=server timestamp. No PII.
    // giftReservations/{catalogId}: uid, name(2..100), phone(10..13 digits), createdAt.
    // rsvps/{uid}: uid, name, phone, attendance(yes/no), guests(0..4), message(0..500), createdAt.
    // admins/{verifiedGoogleEmail}: email, name, createdBy, createdAt. Admin-only.
    // All visitor fields are required and immutable. Admins can read private data and release gifts.
    function authenticated() { return request.auth != null; }
    function owner(uid) { return authenticated() && request.auth.uid == uid; }
    function uidUnchanged(data) { return owner(data.uid); }
    function uidNotModified() { return request.resource.data.uid == resource.data.uid; }
    function verifiedGoogleAccount() {
      return authenticated() && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isAdmin() {
      return verifiedGoogleAccount()
        && (request.auth.token.email == 'matheusevaristo10@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }
    function validGift(id) {
      return id in ['varal', 'puffs', 'protetor', 'escorredor-aco', 'marinex', 'diamond', 'porta-frios', 'potes', 'lixeira', 'gabinete', 'faqueiro', 'pressao', 'cesto', 'assadeiras', 'cama-bege', 'escorredor-branco', 'cafeteira-italiana', 'ferro', 'liquidificador', 'galheteiro', 'lavanderia', 'sanduicheira', 'cama-verde', 'banho'];
    }
    function validContact(data) {
      return uidUnchanged(data) && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.matches('^[0-9]{10,13}$') && data.createdAt == request.time;
    }
    function validStatus(data) {
      return data.keys().hasAll(['reserved', 'createdAt']) && data.keys().hasOnly(['reserved', 'createdAt'])
        && data.reserved == true && data.createdAt == request.time;
    }
    function validReservation(data) {
      return data.keys().hasAll(['uid', 'name', 'phone', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'phone', 'createdAt']) && validContact(data);
    }
    function validRsvp(data) {
      return data.keys().hasAll(['uid', 'name', 'phone', 'attendance', 'guests', 'message', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'phone', 'attendance', 'guests', 'message', 'createdAt'])
        && validContact(data) && data.attendance in ['yes', 'no'] && data.guests is int
        && ((data.attendance == 'yes' && data.guests >= 1 && data.guests <= 4) || (data.attendance == 'no' && data.guests == 0))
        && data.message is string && data.message.size() <= 500;
    }
    function validAdmin(data, email) {
      return data.keys().hasAll(['email', 'name', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'name', 'createdBy', 'createdAt'])
        && data.email is string && data.email == email && data.email.size() >= 5 && data.email.size() <= 254
        && data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.createdBy is string && data.createdBy == request.auth.token.email
        && data.createdAt == request.time;
    }
    match /giftStatus/{id} {
      allow get: if authenticated() && validGift(id);
      allow list: if authenticated() && request.query.limit <= 24;
      allow create: if authenticated() && validGift(id) && validStatus(request.resource.data)
        && !exists(/databases/$(database)/documents/giftReservations/$(id))
        && validReservation(getAfter(/databases/$(database)/documents/giftReservations/$(id)).data);
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /giftReservations/{id} {
      allow create: if authenticated() && validGift(id) && validReservation(request.resource.data)
        && !exists(/databases/$(database)/documents/giftStatus/$(id))
        && validStatus(getAfter(/databases/$(database)/documents/giftStatus/$(id)).data);
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /rsvps/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 200;
      allow create: if owner(uid) && validRsvp(request.resource.data);
      allow update, delete: if false;
    }
    match /admins/{email} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 20;
      allow create: if isAdmin() && validAdmin(request.resource.data, email);
      allow update: if false;
      allow delete: if isAdmin() && email != 'matheusevaristo10@gmail.com';
    }
    match /{document=**} { allow read, write: if false; }
  }
}
